# =============================================================================
# FUND FIT AI - FRONTEND MULTI-STAGE PRODUCTION DOCKERFILE
# Node.js 22 LTS Alpine Build with Standalone Optimization
# =============================================================================

FROM node:22-alpine AS builder
WORKDIR /app

# Install dependencies based on lockfile
COPY package.json package-lock.json ./
RUN npm ci

# Copy application source files
COPY . .

# Build production assets
ENV NODE_ENV=production
RUN npm run build

# -----------------------------------------------------------------------------
# STAGE 2: PRODUCTION RUNTIME
# -----------------------------------------------------------------------------
FROM nginx:1.27-alpine AS runner
WORKDIR /usr/share/nginx/html

# Clean default nginx public files
RUN rm -rf ./*

# Copy build artifacts from builder stage
COPY --from=builder /app/dist ./

# Copy custom frontend Nginx configuration
COPY deployment/nginx/frontend.conf /etc/nginx/conf.d/default.conf

# Expose HTTP port 80
EXPOSE 80

# Run Nginx in foreground mode
CMD ["nginx", "-g", "daemon off;"]
